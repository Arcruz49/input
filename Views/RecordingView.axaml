<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Input.ViewModels"
             x:Class="Input.Views.RecordingView"
             x:DataType="vm:RecordingViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Background="{DynamicResource Bone}">

        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Margin="24,2,24,0">
            <TextBlock Classes="wordmark small" Text="Input" />
            <TextBlock Classes="wordmark-dot small" Text="." />
        </StackPanel>

        <StackPanel Grid.Row="1" VerticalAlignment="Center">

            <Border Classes="pill"
                    Classes.live="{Binding IsRecording}"
                    Classes.done="{Binding HasRecordingToSend}">
                <StackPanel Orientation="Horizontal" Spacing="8">

                    <Ellipse Classes="dot pulse"
                             Fill="{DynamicResource Record}"
                             IsVisible="{Binding IsRecording}" />

                    <Ellipse Classes="dot"
                             Fill="{DynamicResource TextMuted}"
                             IsVisible="{Binding !IsRecording}" />

                    <TextBlock Text="{Binding StateLabel}"
                               FontSize="12.5"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <TextBlock Classes="timer"
                       Classes.idle="{Binding !IsRecording}"
                       Text="{Binding ElapsedText}"
                       Margin="0,26,0,30" />

            <Button Classes="record"
                    Command="{Binding ToggleCommand}">
                <Panel>
                    <Ellipse Classes="rec-ring" />
                    <Border Classes="rec-shape"
                            Classes.recording="{Binding IsRecording}" />
                </Panel>
            </Button>

            <TextBlock Text="{Binding HintText}"
                       Classes="muted"
                       Foreground="{DynamicResource TextMuted}"
                       FontSize="12.5"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,0" />

        </StackPanel>

        <Border Grid.Row="2"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Line}"
                BorderThickness="0,1,0,0"
                Padding="24,18,24,20"
                IsVisible="{Binding ShowFooter}">

            <StackPanel Spacing="12">

                <StackPanel Spacing="7" IsVisible="{Binding HasRecordingToSend}">

                    <TextBlock Classes="label" Text="Nome do projeto" />

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Grid.Column="0"
                                 Text="{Binding ProjectName}"
                                 PlaceholderText="Ex: meu-teste"
                                 Height="42"
                                 Margin="0,0,8,0">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding SendCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>

                        <Button Grid.Column="1"
                                Classes="primary"
                                Content="Enviar"
                                Height="42"
                                MinHeight="42"
                                Command="{Binding SendCommand}" />
                    </Grid>
                </StackPanel>

                <ProgressBar Classes="thin"
                             IsIndeterminate="True"
                             IsVisible="{Binding IsSending}" />

                <TextBlock Classes="status"
                           Classes.error="{Binding StatusIsError}"
                           Text="{Binding StatusText}"
                           IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            </StackPanel>
        </Border>

    </Grid>

</UserControl>
