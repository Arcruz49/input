<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         TIPOGRAFIA
         ============================================================ -->

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- "BEM-VINDO DE VOLTA" -->
    <Style Selector="TextBlock.eyebrow">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LetterSpacing" Value="1.4" />
    </Style>

    <Style Selector="TextBlock.title">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontSize" Value="23" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LetterSpacing" Value="-0.4" />
    </Style>

    <Style Selector="TextBlock.label">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <!-- Linha de status: neutra por padrão, colorida por classe. -->
    <Style Selector="TextBlock.status">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.status.error">
        <Setter Property="Foreground" Value="{DynamicResource Danger}" />
    </Style>

    <Style Selector="TextBlock.status.success">
        <Setter Property="Foreground" Value="{DynamicResource Success}" />
    </Style>

    <!-- Cronômetro: fonte tabular pra não "dançar" a cada segundo. -->
    <Style Selector="TextBlock.timer">
        <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
        <Setter Property="FontSize" Value="42" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="LetterSpacing" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.timer.idle">
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    </Style>

    <!-- ============================================================
         MARCA — o wordmark "Input." do site
         ============================================================ -->

    <Style Selector="TextBlock.wordmark">
        <Setter Property="FontSize" Value="40" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LetterSpacing" Value="-1.6" />
        <Setter Property="Foreground" Value="{DynamicResource TextOnDark}" />
    </Style>

    <Style Selector="TextBlock.wordmark.small">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LetterSpacing" Value="-0.6" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>

    <Style Selector="TextBlock.wordmark-dot">
        <Setter Property="Foreground" Value="{DynamicResource Teal}" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LetterSpacing" Value="-1.6" />
    </Style>

    <Style Selector="TextBlock.wordmark-dot.small">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LetterSpacing" Value="-0.6" />
    </Style>

    <!-- ============================================================
         CAMPOS DE TEXTO
         ============================================================ -->

    <Style Selector="TextBox">
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- O Fluent engrossa a borda de baixo ao focar; aqui a borda fica
         uniforme e só troca de cor. -->
    <Style Selector="TextBox /template/ Border#PART_BorderElement">
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- ============================================================
         BOTÕES
         ============================================================ -->

    <Style Selector="Button">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <!-- Primário (teal) -->
    <Style Selector="Button.primary">
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Accent}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.14" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHover}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentPressed}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    </Style>

    <!-- Secundário: contorno discreto sobre o fundo osso -->
    <Style Selector="Button.ghost">
        <Setter Property="MinHeight" Value="44" />
    </Style>
    <Style Selector="Button.ghost /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.14" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrong}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="Button.ghost:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    </Style>

    <!-- Link ("Criar conta") -->
    <Style Selector="Button.link">
        <Setter Property="Padding" Value="2,0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="Button.link /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AccentHover}" />
    </Style>

    <!-- Botões da barra de título -->
    <Style Selector="Button.chrome">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.chrome /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style Selector="Button.chrome:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource SurfaceHover}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="Button.chrome.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Record}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.chrome Path">
        <Setter Property="Stroke" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style Selector="Button.chrome:pointerover Path">
        <Setter Property="Stroke" Value="{DynamicResource TextPrimary}" />
    </Style>
    <Style Selector="Button.chrome.close:pointerover Path">
        <Setter Property="Stroke" Value="White" />
    </Style>

    <!-- ============================================================
         BOTÃO DE GRAVAÇÃO — o círculo grande, estilo screen recorder
         ============================================================ -->

    <Style Selector="Button.record">
        <Setter Property="Width" Value="104" />
        <Setter Property="Height" Value="104" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="52" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.record /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="52" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.16" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.record:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource RecordSoft}" />
    </Style>
    <Style Selector="Button.record:disabled /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.record:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <!-- O miolo vermelho: círculo quando parado, quadrado quando gravando. -->
    <Style Selector="Border.rec-shape">
        <Setter Property="Width" Value="64" />
        <Setter Property="Height" Value="64" />
        <Setter Property="CornerRadius" Value="32" />
        <Setter Property="Background" Value="{DynamicResource Record}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Width" Duration="0:0:0.22" Easing="CubicEaseOut" />
                <DoubleTransition Property="Height" Duration="0:0:0.22" Easing="CubicEaseOut" />
                <CornerRadiusTransition Property="CornerRadius" Duration="0:0:0.22" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Border.rec-shape.recording">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- Anel externo do botão -->
    <Style Selector="Ellipse.rec-ring">
        <Setter Property="Width" Value="88" />
        <Setter Property="Height" Value="88" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="Stroke" Value="{DynamicResource LineStrong}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============================================================
         PÍLULA DE STATUS + PONTO PULSANTE
         ============================================================ -->

    <Style Selector="Border.pill">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.pill.live">
        <Setter Property="Background" Value="{DynamicResource RecordSoft}" />
    </Style>

    <Style Selector="Border.pill.done">
        <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    </Style>

    <Style Selector="Ellipse.dot">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Ellipse.dot.pulse">
        <Style.Animations>
            <Animation Duration="0:0:1.6" IterationCount="INFINITE" Easing="SineEaseInOut">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="1" />
                </KeyFrame>
                <KeyFrame Cue="50%">
                    <Setter Property="Opacity" Value="0.2" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- ============================================================
         BARRA DE PROGRESSO (indeterminada, durante login/envio)
         ============================================================ -->

    <Style Selector="ProgressBar.thin">
        <Setter Property="Height" Value="2" />
        <Setter Property="MinHeight" Value="2" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        <Setter Property="Background" Value="{DynamicResource SurfaceSunken}" />
    </Style>

</Styles>
